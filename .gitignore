# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
build/
dist/

# Secrets — never committed, ever. Tokens live in env vars only.
.env
.env.*
*.token
*credentials*
!**/CREDENTIAL_SETUP.md

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local test/run artifacts
*.log
.pytest_cache/

# Fetched market data - regenerable via `python fetch_data.py`, not source.
# Keeping it out of git also avoids accidentally publishing paid-vendor data
# (e.g. EODHD chains) under terms that may not permit redistribution.
claude/app/mp_v01/data_store/

# Excel workbooks built by excel_report.py / gui.py. Regenerable from the
# data store, and the ones you have edited by hand are yours, not the repo's.
excel_out/
*.xlsx

# Backtest results and the rendered dashboard. Both are regenerable from the
# data store by pressing a button, and both are timestamped, so committing them
# would grow the repo without adding a record. The PICKS folder is the opposite
# and IS committed: it cannot be regenerated.
backtests/
dashboard.html
